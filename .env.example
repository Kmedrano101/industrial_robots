# === ROS 2 / DDS ===
ROS_DISTRO=humble
UR_ROS_DOMAIN_ID=100              # MUST match on the viz PC
UR_RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# === Robot ===
UR_TYPE=ur7e                      # set to YOUR arm: ur3e/ur5e/ur10e...
ROBOT_IP=200.200.2.2
DRIVER_IP=200.200.2.1
HEADLESS_MODE=false              # false: run External Control program on the pendant; true: driver injects script (needs Remote Control)
EXTRUDER_TYPE=fdm                 # fdm or paste
# Extruder hardware profile (workspace/ur_3d_printer/config/extruders/*.yaml)
EXTRUDER_PROFILE=mahor_v5_m12_pro
# Driver: mock (no electronics, simulated), gcode_serial (Marlin/Klipper board
# over USB — also map the device in docker-compose.yml), topic, ur_io
EXTRUDER_DRIVER=mock
EXTRUDER_SERIAL_PORT=              # e.g. /dev/ttyACM0 (gcode_serial only)

# === Web UI ===
WEB_UI_PORT=8090
ENABLE_TEST_PANEL=false           # bring-up Test panel (status/jog/E-stop); set true to enable

# === Image ===
IMAGE_TAG=ur-3d-printer:humble
