# === ROS 2 / DDS ===
ROS_DISTRO=humble
ROS_DOMAIN_ID=42                  # MUST match on the viz PC
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# === Robot ===
UR_TYPE=ur3e                      # set to YOUR arm: ur3e/ur5e/ur10e...
ROBOT_IP=200.200.2.2
DRIVER_IP=200.200.2.1
HEADLESS_MODE=true
EXTRUDER_TYPE=fdm                 # fdm or paste

# === Web UI ===
WEB_UI_PORT=8090

# === Image ===
IMAGE_TAG=ur-3d-printer:humble
