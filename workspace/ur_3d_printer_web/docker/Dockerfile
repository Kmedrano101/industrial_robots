# =============================================================================
# UR 3D Printer Web Interface - Multi-stage Dockerfile
# =============================================================================
# Stage 1: Build frontend (Node.js)
# Stage 2: Runtime (ROS2 ros-base + Python backend + static frontend)
# =============================================================================

ARG ROS_DISTRO=humble

# -----------------------------------------------------------------------------
# Stage 1: Frontend Build
# -----------------------------------------------------------------------------
FROM node:20-alpine AS frontend-build

WORKDIR /app/frontend
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci --ignore-scripts 2>/dev/null || npm install
COPY frontend/ ./
RUN npm run build

# -----------------------------------------------------------------------------
# Stage 2: Runtime (ROS2 + FastAPI backend)
# -----------------------------------------------------------------------------
# ros-base, not desktop: the backend is a headless rclpy node. desktop adds
# RViz, Qt, OpenGL and their transitive closure (~3 GB) that nothing here
# imports. Everything the bridge needs — rclpy, sensor/trajectory/geometry/
# std msgs, std_srvs — is in ros-base; the rest is installed explicitly.
FROM ros:${ROS_DISTRO}-ros-base AS runtime

ARG ROS_DISTRO
ENV ROS_DISTRO=${ROS_DISTRO}
ENV DEBIAN_FRONTEND=noninteractive

# System + ROS packages in one layer:
#  * python3-pip / curl:        backend deps and the container healthcheck
#  * rmw-cyclonedds-cpp:        the DDS the whole stack runs on
#  * ur-dashboard-msgs:         RobotMode/SafetyMode subs
#  * controller-manager-msgs:   list/switch controller services
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-pip \
    curl \
    ros-${ROS_DISTRO}-rmw-cyclonedds-cpp \
    ros-${ROS_DISTRO}-ur-dashboard-msgs \
    ros-${ROS_DISTRO}-controller-manager-msgs \
    && rm -rf /var/lib/apt/lists/*

# The ur_3d_printer / ur_kinematics_msgs interfaces the bridge subscribes to
# and calls (PrintState, PrintProgress, ExtruderState, StartPrint, ...) are
# generated by colcon in the ur-printer image; only the .msg TEXT lives in
# the source tree mounted at /pkgs. Without the generated Python modules
# `from ur_3d_printer.msg import ...` raised ImportError and ros_bridge
# silently skipped every custom subscription and service client — so print
# telemetry never reached the browser and the print buttons had no client
# to call. Copying the built workspace in fixes that at build time.
#
# `printer` is a named build context wired to the ur-printer service in
# docker-compose.yml, which also makes Compose build that image first. This
# is deliberately a build-time copy rather than a shared volume: a volume
# would keep serving stale interfaces after ur-printer is rebuilt, and it
# would do so silently, whereas a missing build context fails loudly.
COPY --from=printer /ros2_ws/install /ros2_ws/install

# Create non-root user. Newer ros:*-ros-base images ship with an `ubuntu`
# user at UID/GID 1000, so we rename instead of creating fresh.
RUN if getent group 1000 >/dev/null; then \
        groupmod -n web "$(getent group 1000 | cut -d: -f1)"; \
    else \
        groupadd -g 1000 web; \
    fi && \
    if getent passwd 1000 >/dev/null; then \
        usermod -l web -d /home/web -m -g web "$(getent passwd 1000 | cut -d: -f1)" 2>/dev/null || true; \
        usermod -s /bin/bash web; \
    else \
        useradd -m -u 1000 -g web -s /bin/bash web; \
    fi

# Install Python packages. --break-system-packages is required on Noble
# (PEP 668 externally-managed) but does not exist on Jammy's pip (humble base),
# so detect support at build time and only pass it when available.
COPY backend/requirements.txt /tmp/requirements.txt
RUN BSP=$(pip3 install --help 2>&1 | grep -q -- --break-system-packages && echo --break-system-packages || true); \
    pip3 install --no-cache-dir $BSP -r /tmp/requirements.txt \
    && rm /tmp/requirements.txt

# Copy backend
WORKDIR /app
COPY backend/ /app/backend/

# Copy frontend build
COPY --from=frontend-build /app/frontend/dist /app/static

# The slicer modules come from the ur_3d_printer package, which
# docker-compose mounts read-only at /pkgs (source tree, for resource/
# scripts) on top of the colcon install overlay above (generated
# interfaces). Nothing from this package's own directory is needed beyond
# backend/, so it is not copied in: a previous `COPY . /app/web_package`
# dragged the frontend's node_modules (~400 MB) into the image for no use.

# Create upload directory
RUN mkdir -p /uploads && chown web:web /uploads

# Environment defaults
ENV WEB_PORT=8090
ENV UPLOAD_DIR=/uploads
ENV STATIC_DIR=/app/static
ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
ENV PYTHONPATH=/app:/pkgs

USER web

# Entrypoint: source ROS2 and start server
COPY --chown=web:web docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh 2>/dev/null || true

EXPOSE 8090

HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=4 \
    CMD curl -sf http://localhost:${WEB_PORT}/api/health || exit 1

# Go through entrypoint.sh rather than sourcing ROS inline: it also selects
# the right CycloneDDS config, without which rclpy cannot create its node.
ENTRYPOINT ["/entrypoint.sh"]
CMD ["/bin/bash", "-c", "exec python3 -m uvicorn backend.main:app --host 0.0.0.0 --port ${WEB_PORT}"]
