<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="parallel_gripper">

  <!-- Standalone mode argument -->
  <xacro:arg name="standalone" default="false"/>

  <!-- Gripper parameters -->
  <xacro:property name="gripper_base_length" value="0.05"/>
  <xacro:property name="gripper_base_width" value="0.08"/>
  <xacro:property name="gripper_base_height" value="0.03"/>
  <xacro:property name="finger_length" value="0.06"/>
  <xacro:property name="finger_width" value="0.012"/>
  <xacro:property name="finger_height" value="0.02"/>
  <xacro:property name="max_opening" value="0.08"/>

  <!-- Materials -->
  <material name="gripper_dark_gray">
    <color rgba="0.3 0.3 0.3 1.0"/>
  </material>

  <material name="gripper_silver">
    <color rgba="0.7 0.7 0.7 1.0"/>
  </material>

  <xacro:macro name="parallel_gripper" params="parent prefix:=''">

    <!-- Gripper base attached to parent (tool0) -->
    <!-- Rotated so gripper fingers point along tool0 Z-axis (outward from flange) -->
    <joint name="${prefix}gripper_base_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 ${pi/2} 0"/>
      <parent link="${parent}"/>
      <child link="${prefix}gripper_base_link"/>
    </joint>

    <link name="${prefix}gripper_base_link">
      <visual>
        <geometry>
          <box size="${gripper_base_length} ${gripper_base_width} ${gripper_base_height}"/>
        </geometry>
        <origin xyz="${gripper_base_length/2} 0 0" rpy="0 0 0"/>
        <material name="gripper_dark_gray"/>
      </visual>
      <collision>
        <geometry>
          <box size="${gripper_base_length} ${gripper_base_width} ${gripper_base_height}"/>
        </geometry>
        <origin xyz="${gripper_base_length/2} 0 0" rpy="0 0 0"/>
      </collision>
      <inertial>
        <mass value="0.5"/>
        <origin xyz="${gripper_base_length/2} 0 0" rpy="0 0 0"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
    </link>

    <!-- Left finger (fixed joint for visualization, semi-closed position) -->
    <joint name="${prefix}gripper_left_finger_joint" type="fixed">
      <parent link="${prefix}gripper_base_link"/>
      <child link="${prefix}gripper_left_finger"/>
      <origin xyz="${gripper_base_length} 0.015 0" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}gripper_left_finger">
      <visual>
        <geometry>
          <box size="${finger_length} ${finger_width} ${finger_height}"/>
        </geometry>
        <origin xyz="${finger_length/2} 0 0" rpy="0 0 0"/>
        <material name="gripper_silver"/>
      </visual>
      <collision>
        <geometry>
          <box size="${finger_length} ${finger_width} ${finger_height}"/>
        </geometry>
        <origin xyz="${finger_length/2} 0 0" rpy="0 0 0"/>
      </collision>
      <inertial>
        <mass value="0.1"/>
        <origin xyz="${finger_length/2} 0 0" rpy="0 0 0"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>

    <!-- Right finger (fixed joint for visualization, semi-closed position) -->
    <joint name="${prefix}gripper_right_finger_joint" type="fixed">
      <parent link="${prefix}gripper_base_link"/>
      <child link="${prefix}gripper_right_finger"/>
      <origin xyz="${gripper_base_length} -0.015 0" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}gripper_right_finger">
      <visual>
        <geometry>
          <box size="${finger_length} ${finger_width} ${finger_height}"/>
        </geometry>
        <origin xyz="${finger_length/2} 0 0" rpy="0 0 0"/>
        <material name="gripper_silver"/>
      </visual>
      <collision>
        <geometry>
          <box size="${finger_length} ${finger_width} ${finger_height}"/>
        </geometry>
        <origin xyz="${finger_length/2} 0 0" rpy="0 0 0"/>
      </collision>
      <inertial>
        <mass value="0.1"/>
        <origin xyz="${finger_length/2} 0 0" rpy="0 0 0"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>

    <!-- TCP (Tool Center Point) at fingertip center -->
    <joint name="${prefix}gripper_tcp_joint" type="fixed">
      <parent link="${prefix}gripper_base_link"/>
      <child link="${prefix}gripper_tcp"/>
      <origin xyz="${gripper_base_length + finger_length} 0 0" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}gripper_tcp">
      <visual>
        <geometry>
          <sphere radius="0.005"/>
        </geometry>
        <material name="gripper_silver"/>
      </visual>
    </link>

  </xacro:macro>

  <!-- Standalone instantiation (attaches to gripper_mount frame) -->
  <xacro:if value="$(arg standalone)">
    <link name="gripper_mount"/>
    <xacro:parallel_gripper parent="gripper_mount" prefix=""/>
  </xacro:if>

</robot>
