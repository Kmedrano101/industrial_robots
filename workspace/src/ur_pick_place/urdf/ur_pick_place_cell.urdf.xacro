<?xml version="1.0"?>
<!--
  UR Pick and Place Workcell Description

  This is a complete workcell description that includes:
  - UR robot arm (from ur_description)
  - Industrial table with robot mount
  - Parallel gripper attached to tool flange
  - Pick and place objects (cubes)

  This URDF can be used with ur_robot_driver by passing it as the robot_description.
  It extends the base ur_description without modifying it.

  Usage:
    xacro ur_pick_place_cell.urdf.xacro ur_type:=ur5e
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ur_pick_place_cell">

  <!-- ============================================================ -->
  <!-- Arguments -->
  <!-- ============================================================ -->
  <xacro:arg name="ur_type" default="ur5e"/>
  <xacro:arg name="tf_prefix" default=""/>
  <xacro:arg name="joint_limit_params" default="$(find ur_description)/config/$(arg ur_type)/joint_limits.yaml"/>
  <xacro:arg name="kinematics_params" default="$(find ur_description)/config/$(arg ur_type)/default_kinematics.yaml"/>
  <xacro:arg name="physical_params" default="$(find ur_description)/config/$(arg ur_type)/physical_parameters.yaml"/>
  <xacro:arg name="visual_params" default="$(find ur_description)/config/$(arg ur_type)/visual_parameters.yaml"/>
  <xacro:arg name="safety_limits" default="false"/>
  <xacro:arg name="safety_pos_margin" default="0.15"/>
  <xacro:arg name="safety_k_position" default="20"/>

  <!-- ros2_control related parameters -->
  <xacro:arg name="headless_mode" default="false"/>
  <xacro:arg name="robot_ip" default="0.0.0.0"/>
  <xacro:arg name="script_filename" default=""/>
  <xacro:arg name="output_recipe_filename" default=""/>
  <xacro:arg name="input_recipe_filename" default=""/>
  <xacro:arg name="reverse_ip" default="0.0.0.0"/>
  <xacro:arg name="script_command_port" default="50004"/>
  <xacro:arg name="reverse_port" default="50001"/>
  <xacro:arg name="script_sender_port" default="50002"/>
  <xacro:arg name="trajectory_port" default="50003"/>
  <!-- Tool communication -->
  <xacro:arg name="use_tool_communication" default="false"/>
  <xacro:arg name="tool_voltage" default="0"/>
  <xacro:arg name="tool_parity" default="0"/>
  <xacro:arg name="tool_baud_rate" default="115200"/>
  <xacro:arg name="tool_stop_bits" default="1"/>
  <xacro:arg name="tool_rx_idle_chars" default="1.5"/>
  <xacro:arg name="tool_tx_idle_chars" default="3.5"/>
  <xacro:arg name="tool_device_name" default="/tmp/ttyUR"/>
  <xacro:arg name="tool_tcp_port" default="54321"/>
  <!-- Simulation parameters -->
  <xacro:arg name="use_mock_hardware" default="false"/>
  <xacro:arg name="mock_sensor_commands" default="false"/>

  <!-- Scene arguments -->
  <xacro:arg name="include_table" default="true"/>
  <xacro:arg name="include_gripper" default="true"/>
  <xacro:arg name="include_objects" default="true"/>

  <!-- Table height and robot mount position -->
  <xacro:arg name="table_height" default="0.9"/>
  <xacro:arg name="robot_mount_x" default="-0.55"/>

  <!-- ============================================================ -->
  <!-- Include base components -->
  <!-- ============================================================ -->
  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>
  <xacro:include filename="$(find ur_robot_driver)/urdf/ur.ros2_control.xacro"/>
  <xacro:include filename="$(find ur_pick_place)/urdf/parallel_gripper.urdf.xacro"/>
  <xacro:include filename="$(find ur_pick_place)/urdf/industrial_table.urdf.xacro"/>

  <!-- ============================================================ -->
  <!-- Properties -->
  <!-- ============================================================ -->
  <xacro:property name="table_height" value="$(arg table_height)"/>
  <xacro:property name="robot_mount_x" value="$(arg robot_mount_x)"/>

  <!-- ============================================================ -->
  <!-- Materials -->
  <!-- ============================================================ -->
  <material name="object_red">
    <color rgba="0.8 0.2 0.2 1.0"/>
  </material>

  <material name="object_green">
    <color rgba="0.2 0.8 0.2 1.0"/>
  </material>

  <material name="object_blue">
    <color rgba="0.2 0.2 0.8 1.0"/>
  </material>

  <material name="object_yellow">
    <color rgba="0.9 0.9 0.2 1.0"/>
  </material>

  <!-- ============================================================ -->
  <!-- World Frame -->
  <!-- ============================================================ -->
  <link name="world"/>

  <!-- ============================================================ -->
  <!-- Industrial Table (conditional) -->
  <!-- ============================================================ -->
  <xacro:if value="$(arg include_table)">
    <xacro:industrial_table parent="world" prefix=""/>
  </xacro:if>

  <!-- If no table, create a simple robot mount at table height -->
  <xacro:unless value="$(arg include_table)">
    <joint name="robot_mount_joint" type="fixed">
      <parent link="world"/>
      <child link="robot_mount"/>
      <origin xyz="0 0 ${table_height}" rpy="0 0 0"/>
    </joint>
    <link name="robot_mount"/>
  </xacro:unless>

  <!-- ============================================================ -->
  <!-- UR Robot -->
  <!-- ============================================================ -->
  <xacro:ur_robot
    name="$(arg ur_type)"
    tf_prefix="$(arg tf_prefix)"
    parent="robot_mount"
    joint_limits_parameters_file="$(arg joint_limit_params)"
    kinematics_parameters_file="$(arg kinematics_params)"
    physical_parameters_file="$(arg physical_params)"
    visual_parameters_file="$(arg visual_params)"
    safety_limits="$(arg safety_limits)"
    safety_pos_margin="$(arg safety_pos_margin)"
    safety_k_position="$(arg safety_k_position)">
    <origin xyz="0 0 0.02" rpy="0 0 0"/>
  </xacro:ur_robot>

  <!-- ============================================================ -->
  <!-- ros2_control Hardware Interface -->
  <!-- ============================================================ -->
  <xacro:ur_ros2_control
    name="$(arg ur_type)"
    tf_prefix="$(arg tf_prefix)"
    kinematics_parameters_file="$(arg kinematics_params)"
    robot_ip="$(arg robot_ip)"
    script_filename="$(arg script_filename)"
    output_recipe_filename="$(arg output_recipe_filename)"
    input_recipe_filename="$(arg input_recipe_filename)"
    headless_mode="$(arg headless_mode)"
    use_mock_hardware="$(arg use_mock_hardware)"
    mock_sensor_commands="$(arg mock_sensor_commands)"
    use_tool_communication="$(arg use_tool_communication)"
    tool_voltage="$(arg tool_voltage)"
    tool_parity="$(arg tool_parity)"
    tool_baud_rate="$(arg tool_baud_rate)"
    tool_stop_bits="$(arg tool_stop_bits)"
    tool_rx_idle_chars="$(arg tool_rx_idle_chars)"
    tool_tx_idle_chars="$(arg tool_tx_idle_chars)"
    tool_device_name="$(arg tool_device_name)"
    tool_tcp_port="$(arg tool_tcp_port)"
    reverse_ip="$(arg reverse_ip)"
    reverse_port="$(arg reverse_port)"
    script_sender_port="$(arg script_sender_port)"
    script_command_port="$(arg script_command_port)"
    trajectory_port="$(arg trajectory_port)"
  />

  <!-- ============================================================ -->
  <!-- Parallel Gripper (conditional) -->
  <!-- ============================================================ -->
  <xacro:if value="$(arg include_gripper)">
    <xacro:parallel_gripper parent="$(arg tf_prefix)tool0" prefix="$(arg tf_prefix)"/>
  </xacro:if>

  <!-- ============================================================ -->
  <!-- Pick and Place Objects (conditional) -->
  <!-- ============================================================ -->
  <xacro:if value="$(arg include_objects)">

    <!-- Object macro for pick/place cubes -->
    <xacro:macro name="pick_object" params="name parent x y z size:=0.04 color:=object_red">
      <joint name="${name}_joint" type="fixed">
        <parent link="${parent}"/>
        <child link="${name}"/>
        <origin xyz="${x} ${y} ${z + size/2}" rpy="0 0 0"/>
      </joint>

      <link name="${name}">
        <visual>
          <geometry>
            <box size="${size} ${size} ${size}"/>
          </geometry>
          <material name="${color}"/>
        </visual>
        <collision>
          <geometry>
            <box size="${size} ${size} ${size}"/>
          </geometry>
        </collision>
        <inertial>
          <mass value="0.1"/>
          <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
        </inertial>
      </link>
    </xacro:macro>

    <!-- Pick location objects (in front of robot, right side) -->
    <xacro:pick_object name="pick_object_1" parent="table_top"
                       x="0.15" y="0.20" z="0.025" color="object_red"/>
    <xacro:pick_object name="pick_object_2" parent="table_top"
                       x="0.25" y="0.20" z="0.025" color="object_green"/>
    <xacro:pick_object name="pick_object_3" parent="table_top"
                       x="0.20" y="0.12" z="0.025" color="object_blue"/>

    <!-- Place location markers (right side of workspace) -->
    <xacro:macro name="place_marker" params="name parent x y z size:=0.06">
      <joint name="${name}_joint" type="fixed">
        <parent link="${parent}"/>
        <child link="${name}"/>
        <origin xyz="${x} ${y} ${z + 0.001}" rpy="0 0 0"/>
      </joint>

      <link name="${name}">
        <visual>
          <geometry>
            <box size="${size} ${size} 0.002"/>
          </geometry>
          <material name="object_yellow"/>
        </visual>
      </link>
    </xacro:macro>

    <xacro:place_marker name="place_marker_1" parent="table_top"
                        x="0.15" y="-0.20" z="0.025"/>
    <xacro:place_marker name="place_marker_2" parent="table_top"
                        x="0.25" y="-0.20" z="0.025"/>
    <xacro:place_marker name="place_marker_3" parent="table_top"
                        x="0.20" y="-0.12" z="0.025"/>

  </xacro:if>

</robot>
