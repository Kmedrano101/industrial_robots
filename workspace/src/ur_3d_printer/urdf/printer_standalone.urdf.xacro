<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="printer_standalone">
  <!--
    Standalone scene for testing without ur_description package.
    Uses simplified robot representation with FDM extruder and print bed.
  -->

  <!-- Include extruder and bed -->
  <xacro:include filename="$(find ur_3d_printer)/urdf/fdm_extruder.urdf.xacro"/>
  <xacro:include filename="$(find ur_3d_printer)/urdf/print_bed.urdf.xacro"/>

  <!-- World frame -->
  <link name="world"/>

  <!-- Table surface (simplified) -->
  <joint name="table_joint" type="fixed">
    <parent link="world"/>
    <child link="table_top"/>
    <origin xyz="0 0 0.9" rpy="0 0 0"/>
  </joint>

  <link name="table_top">
    <visual>
      <geometry>
        <box size="1.2 0.8 0.025"/>
      </geometry>
      <origin xyz="0.3 0 -0.0125" rpy="0 0 0"/>
      <material name="table_gray">
        <color rgba="0.6 0.6 0.6 1.0"/>
      </material>
    </visual>
  </link>

  <!-- Robot mount on table -->
  <joint name="robot_mount_joint" type="fixed">
    <parent link="table_top"/>
    <child link="robot_mount"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="robot_mount"/>

  <!-- Simplified UR5e robot base -->
  <joint name="robot_base_joint" type="fixed">
    <parent link="robot_mount"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.02" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry>
        <cylinder radius="0.075" length="0.05"/>
      </geometry>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <material name="ur_gray">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
  </link>

  <!-- Simplified arm -->
  <joint name="shoulder_pan_joint" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0 0.1625" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.28" upper="6.28" effort="150" velocity="3.14"/>
  </joint>

  <link name="shoulder_link">
    <visual>
      <geometry>
        <cylinder radius="0.06" length="0.12"/>
      </geometry>
      <material name="ur_blue">
        <color rgba="0.0 0.4 0.8 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="shoulder_lift_joint" type="revolute">
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0 0 0" rpy="0 1.5708 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-6.28" upper="6.28" effort="150" velocity="3.14"/>
  </joint>

  <link name="upper_arm_link">
    <visual>
      <geometry>
        <box size="0.425 0.08 0.08"/>
      </geometry>
      <origin xyz="0.2125 0 0" rpy="0 0 0"/>
      <material name="ur_blue"/>
    </visual>
  </link>

  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="0.425 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="3.14" effort="150" velocity="3.14"/>
  </joint>

  <link name="forearm_link">
    <visual>
      <geometry>
        <box size="0.3922 0.06 0.06"/>
      </geometry>
      <origin xyz="0.1961 0 0" rpy="0 0 0"/>
      <material name="ur_blue"/>
    </visual>
  </link>

  <joint name="wrist_1_joint" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_1_link"/>
    <origin xyz="0.3922 0 0.1333" rpy="0 1.5708 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-6.28" upper="6.28" effort="28" velocity="3.14"/>
  </joint>

  <link name="wrist_1_link">
    <visual>
      <geometry>
        <cylinder radius="0.04" length="0.08"/>
      </geometry>
      <material name="ur_gray"/>
    </visual>
  </link>

  <joint name="wrist_2_joint" type="revolute">
    <parent link="wrist_1_link"/>
    <child link="wrist_2_link"/>
    <origin xyz="0 0.0997 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.28" upper="6.28" effort="28" velocity="3.14"/>
  </joint>

  <link name="wrist_2_link">
    <visual>
      <geometry>
        <cylinder radius="0.04" length="0.08"/>
      </geometry>
      <material name="ur_gray"/>
    </visual>
  </link>

  <joint name="wrist_3_joint" type="revolute">
    <parent link="wrist_2_link"/>
    <child link="wrist_3_link"/>
    <origin xyz="0 0 0.0996" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-6.28" upper="6.28" effort="28" velocity="3.14"/>
  </joint>

  <link name="wrist_3_link">
    <visual>
      <geometry>
        <cylinder radius="0.035" length="0.04"/>
      </geometry>
      <material name="ur_gray"/>
    </visual>
  </link>

  <!-- Tool flange -->
  <joint name="tool0_joint" type="fixed">
    <parent link="wrist_3_link"/>
    <child link="tool0"/>
    <origin xyz="0 0.0823 0" rpy="-1.5708 0 0"/>
  </joint>

  <link name="tool0"/>

  <!-- FDM Extruder attached to tool0 -->
  <xacro:fdm_extruder parent="tool0" prefix=""/>

  <!-- Print bed -->
  <xacro:print_bed parent="world" prefix="" x="0.4" y="0.0" z="0.925"/>

</robot>
