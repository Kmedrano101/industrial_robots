<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fdm_extruder">

  <xacro:arg name="standalone" default="false"/>

  <!-- FDM Extruder Parameters -->
  <xacro:property name="heatsink_length" value="0.04"/>
  <xacro:property name="heatsink_width" value="0.04"/>
  <xacro:property name="heatsink_height" value="0.06"/>
  <xacro:property name="heatbreak_length" value="0.03"/>
  <xacro:property name="heatbreak_radius" value="0.008"/>
  <xacro:property name="nozzle_length" value="0.015"/>
  <xacro:property name="nozzle_radius" value="0.006"/>
  <xacro:property name="total_length" value="0.105"/>  <!-- heatsink + heatbreak + nozzle -->

  <!-- Materials -->
  <material name="extruder_aluminum">
    <color rgba="0.7 0.7 0.7 1.0"/>
  </material>

  <material name="extruder_brass">
    <color rgba="0.8 0.7 0.3 1.0"/>
  </material>

  <material name="extruder_dark">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>

  <xacro:macro name="fdm_extruder" params="parent prefix:=''">

    <!-- Extruder mount (fixed to tool0, aligned along tool Z-axis) -->
    <joint name="${prefix}extruder_base_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${parent}"/>
      <child link="${prefix}extruder_heatsink"/>
    </joint>

    <!-- Heatsink body -->
    <link name="${prefix}extruder_heatsink">
      <visual>
        <geometry>
          <box size="${heatsink_width} ${heatsink_width} ${heatsink_height}"/>
        </geometry>
        <origin xyz="0 0 ${heatsink_height/2}" rpy="0 0 0"/>
        <material name="extruder_aluminum"/>
      </visual>
      <collision>
        <geometry>
          <box size="${heatsink_width} ${heatsink_width} ${heatsink_height}"/>
        </geometry>
        <origin xyz="0 0 ${heatsink_height/2}" rpy="0 0 0"/>
      </collision>
      <inertial>
        <mass value="0.3"/>
        <origin xyz="0 0 ${heatsink_height/2}" rpy="0 0 0"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
    </link>

    <!-- Heatbreak -->
    <joint name="${prefix}heatbreak_joint" type="fixed">
      <parent link="${prefix}extruder_heatsink"/>
      <child link="${prefix}extruder_heatbreak"/>
      <origin xyz="0 0 ${heatsink_height}" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}extruder_heatbreak">
      <visual>
        <geometry>
          <cylinder radius="${heatbreak_radius}" length="${heatbreak_length}"/>
        </geometry>
        <origin xyz="0 0 ${heatbreak_length/2}" rpy="0 0 0"/>
        <material name="extruder_dark"/>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="${heatbreak_radius}" length="${heatbreak_length}"/>
        </geometry>
        <origin xyz="0 0 ${heatbreak_length/2}" rpy="0 0 0"/>
      </collision>
      <inertial>
        <mass value="0.05"/>
        <origin xyz="0 0 ${heatbreak_length/2}" rpy="0 0 0"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>

    <!-- Nozzle -->
    <joint name="${prefix}nozzle_joint" type="fixed">
      <parent link="${prefix}extruder_heatbreak"/>
      <child link="${prefix}extruder_nozzle"/>
      <origin xyz="0 0 ${heatbreak_length}" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}extruder_nozzle">
      <visual>
        <geometry>
          <cylinder radius="${nozzle_radius}" length="${nozzle_length}"/>
        </geometry>
        <origin xyz="0 0 ${nozzle_length/2}" rpy="0 0 0"/>
        <material name="extruder_brass"/>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="${nozzle_radius}" length="${nozzle_length}"/>
        </geometry>
        <origin xyz="0 0 ${nozzle_length/2}" rpy="0 0 0"/>
      </collision>
      <inertial>
        <mass value="0.02"/>
        <origin xyz="0 0 ${nozzle_length/2}" rpy="0 0 0"/>
        <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
      </inertial>
    </link>

    <!-- Nozzle TCP (Tool Center Point at nozzle tip) -->
    <joint name="${prefix}nozzle_tcp_joint" type="fixed">
      <parent link="${prefix}extruder_nozzle"/>
      <child link="${prefix}nozzle_tcp"/>
      <origin xyz="0 0 ${nozzle_length}" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}nozzle_tcp">
      <visual>
        <geometry>
          <sphere radius="0.003"/>
        </geometry>
        <material name="extruder_brass"/>
      </visual>
    </link>

  </xacro:macro>

  <!-- Standalone instantiation -->
  <xacro:if value="$(arg standalone)">
    <link name="extruder_mount"/>
    <xacro:fdm_extruder parent="extruder_mount" prefix=""/>
  </xacro:if>

</robot>
