Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    # Ground grid
    - Alpha: 0.5
      Cell Size: 0.5
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>

    # Optical table
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Description Topic:
        Value: /table/robot_description
      Enabled: true
      Name: Optical Table
      Visual Enabled: true
      Collision Enabled: false

    # Robot arm from driver
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Description Topic:
        Value: /robot_description
      Enabled: true
      Name: UR Robot
      Visual Enabled: true
      Collision Enabled: false

    # Extruder mounted on tool0
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Description Topic:
        Value: /extruder/robot_description
      Enabled: true
      Name: Extruder
      Visual Enabled: true
      Collision Enabled: false

    # Print bed
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Description Topic:
        Value: /print_bed/robot_description
      Enabled: true
      Name: Print Bed
      Visual Enabled: true
      Collision Enabled: false

    # TF frames (disable by default, enable in RViz for debugging)
    - Class: rviz_default_plugins/TF
      Enabled: false
      Name: TF
      Frame Timeout: 15
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Marker Scale: 0.3
      Update Interval: 0

    # Full toolpath as colored line strips.
    # Pre-print: blue→red gradient by layer height.
    # During print: green = done, yellow = current, gray = remaining.
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: ToolpathMarkers
      Topic:
        Value: /toolpath_visualizer/markers
        Depth: 5

    # Tool flange axes so you can see where the nozzle tip is
    - Class: rviz_default_plugins/Axes
      Enabled: true
      Length: 0.05
      Name: Tool0 Axes
      Radius: 0.005
      Reference Frame: tool0

  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.8
      Focal Point:
        X: 0.4
        Y: 0.0
        Z: 0.95
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.55
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz_default_plugins)
      Yaw: 0.8
    Saved:
      - Class: rviz_default_plugins/Orbit
        Distance: 1.2
        Focal Point:
          X: 0.42
          Y: 0.0
          Z: 0.97
        Name: Print Bed Close
        Pitch: 0.9
        Yaw: 0.5
      - Class: rviz_default_plugins/Orbit
        Distance: 2.5
        Focal Point:
          X: 0.2
          Y: 0.0
          Z: 0.95
        Name: Robot Side View
        Pitch: 0.3
        Yaw: 0.0
      - Class: rviz_default_plugins/Orbit
        Distance: 2.0
        Focal Point:
          X: 0.4
          Y: 0.0
          Z: 1.0
        Name: Top Down
        Pitch: 1.5
        Yaw: 0.0
Window Geometry:
  Height: 900
  Width: 1400
  X: 100
  Y: 100
